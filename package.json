{
  "name": "bettercli-for-claude",
  "productName": "BetterCLI for Claude",
  "version": "0.2.2",
  "description": "Desktop session manager for Claude Code: tabs, groups, and one-click session forks",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "lvyyln",
    "email": "lvyyln@users.noreply.github.com"
  },
  "homepage": "https://github.com/lvyyln/bettercli-for-claude",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvyyln/bettercli-for-claude.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/render-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.lvyyln.bettercli",
    "productName": "BetterCLI for Claude",
    "artifactName": "BetterCLI-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BetterCLI-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BetterCLI-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "lvyyln <lvyyln@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "lvyyln",
      "repo": "bettercli-for-claude",
      "releaseType": "draft"
    }
  }
}
